{
    "version": 4,
    "configurePresets":
    [
        {
            "name": "text",
            "binaryDir": "${sourceDir}/__build__",
            "cacheVariables": {
                "compilation_mode": "NORMAL"
            }
        },
        {
            "name": "devquote",
            "binaryDir": "${sourceDir}/__build_devquote__",
            "cacheVariables": {
                "compilation_mode": "DEVQUOTE"
            }
        },

        {
            "name": "windows",
            "binaryDir": "${sourceDir}/__build_windows__",
            "cacheVariables": {
                "compilation_mode": "TOOLCHAIN_WINDOWS"
            }
        },
        {
            "name": "windows_devquote",
            "binaryDir": "${sourceDir}/__build_windows_devquote__",
            "cacheVariables": {
                "compilation_mode": "TOOLCHAIN_WINDOWS_DEVQUOTE"
            }
        }
    ]
}
